{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netdust.be/flow.schema.json",
  "title": "netdust-flow definition",
  "type": "object",
  "required": ["flow", "version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "flow":    { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 0 },
    "state":   { "type": "object" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id":    { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind":  { "enum": ["agent", "gate", "human"] },
        "craft": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "run":   { "type": "string" },
        "in":    { "type": "array", "items": { "type": "string" } },
        "out":   { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if":   { "properties": { "kind": { "const": "gate" } } },
          "then": { "required": ["run"] }
        },
        {
          "if":   { "properties": { "kind": { "const": "agent" } } },
          "then": { "required": ["craft"] }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to":   { "type": "string" },
        "when": {
          "type": "string",
          "description": "Machine-readable only: <state key> <op> <literal>; ops: == != > >= < <= in. Prose conditions are rejected by flow-lint (invariant I1)."
        }
      }
    }
  }
}
